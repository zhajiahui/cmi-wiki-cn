        "id": "colorsglobalneutral",
        "source_line": 76,
        "text": "使用 {gcn} 引用此颜色。默认值：{#gray}\n较为中性的颜色，用于无需引起过多注意的文本。",
        "block": 9,
        "line": 20,
        "heading": false
      },
