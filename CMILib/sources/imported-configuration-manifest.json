        ],
        "id": "colorsglobalsecondary",
        "source_line": 70,
        "text": "使用 {gcs} 引用此颜色。默认值：{#yellow}\n通常用于变量和占位符。",
        "block": 9,
        "line": 14,
        "heading": false
      },
      {
        "path": [
          "Colors",
          "Global",
