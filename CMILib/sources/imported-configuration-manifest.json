        ],
        "id": "colorsglobalprimary",
        "source_line": 67,
        "text": "使用 {gcp} 引用此颜色。默认值：{#gold}\n普通文本使用的主要颜色。",
        "block": 9,
        "line": 11,
        "heading": false
      },
      {
        "path": [
          "Colors",
          "Global",
