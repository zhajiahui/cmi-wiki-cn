        ],
        "id": "colorsglobalwarning",
        "source_line": 73,
        "text": "使用 {gcw} 引用此颜色。默认值：{#FF7357}\n用于提示命令用法有误，通常不如错误提示重要。",
        "block": 9,
        "line": 17,
        "heading": false
      },
